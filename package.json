{
  "name": "taskmanager-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "cloudflare",
    "taskmanagerfront"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace taskmanager-cloudflare",
    "dev:frontend": "npm run dev --workspace taskmanagerfront",
    "build": "npm run typecheck && npm run build --workspace taskmanagerfront",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run build && npm run test:coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend",
    "test:coverage": "vitest run --coverage"
  }
}
